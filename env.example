# Copy this file to .env, replace every REPLACE_* value, then run:
# chmod 600 .env

# Container timezone.
TZ=Europe/Ljubljana

# Public hostname configured as a Cloudflare Tunnel public hostname.
# Browser-facing HTTPS is terminated by Cloudflare.
DOMAIN=chat.example.com

# Pin a specific tested Mattermost Team Edition version.
# Do not use latest in production.
MATTERMOST_IMAGE_TAG=REPLACE_WITH_TESTED_MATTERMOST_VERSION

# PostgreSQL credentials.
# Generate a long alphanumeric password, because it is used in a PostgreSQL URL.
POSTGRES_DB=mattermost
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD

# Maximum single attachment size: 1 GiB.
MAX_FILE_SIZE_BYTES=1073741824

# SMTP provider credentials for invitations, password resets, verification-related
# mail, and email notifications. Use a provider-verified sending domain.
SMTP_FROM_NAME=Mattermost
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=smtp.example-provider.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD

# Normally STARTTLS for SMTP port 587. Use TLS only if your provider requires
# implicit TLS, commonly on port 465.
SMTP_CONNECTION_SECURITY=STARTTLS
