# -----------------------------------------------------------------------------
# Mattermost + PostgreSQL + Caddy
# Copy to .env, replace every REPLACE_* value, then run: chmod 600 .env
# -----------------------------------------------------------------------------

# Timezone used by the Mattermost container.
TZ=Europe/Ljubljana

# Public DNS name. Create an A/AAAA DNS record pointing it to this server.
DOMAIN=chat.example.com
ACME_EMAIL=admin@example.com

# Public host ports.
# Recommended normal Internet deployment: 80 and 443.
# If you use 8443, users must open https://chat.example.com:8443.
HTTP_PORT=80
HTTPS_PORT=443

# Pin a specific Mattermost Team Edition release that you have tested.
# Never use latest in production. Check the official release notes before upgrades.
MATTERMOST_IMAGE_TAG=REPLACE_WITH_TESTED_MATTERMOST_VERSION

# PostgreSQL database credentials.
# Use a long random alphanumeric password; it is inserted into a database URL.
POSTGRES_DB=mattermost
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=REPLACE_WITH_48_OR_MORE_RANDOM_ALPHANUMERIC_CHARACTERS

# Maximum size of one uploaded attachment: 1 GiB.
# Lower this if disk capacity, backups, or bandwidth require it.
MAX_FILE_SIZE_BYTES=1073741824

# SMTP sender and provider credentials.
# Use a provider/domain you have verified, with SPF, DKIM, and DMARC configured.
SMTP_FROM_NAME=Mattermost
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=smtp.example-provider.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD

# Most transactional SMTP providers use STARTTLS on port 587.
# Use TLS instead when your provider specifically instructs you to use port 465.
SMTP_CONNECTION_SECURITY=STARTTLS
